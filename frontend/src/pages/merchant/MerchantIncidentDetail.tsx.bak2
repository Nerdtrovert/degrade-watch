import { useEffect, useState } from 'react';
import { Link, useParams } from 'react-router-dom';
import { merchantAPI } from '../../api/merchant';

const MerchantIncidentDetail: React.FC = () => {
  const { incidentId } = useParams<{ incidentId: string }>();
  const [data, setData] = useState<any>(null);
  const [loading, setLoading] = useState<boolean>(true);
  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
    const fetchIncident = async () => {
      try {
        setLoading(true);
        const response = await merchantAPI.getIncidentDetail(incidentId!);
        setData(response.data);
        setError(null);
      } catch (err: any) {
        console.error('Failed to fetch incident detail:', err);
        if (err.response?.status === 404) {
          setError('Incident not found');
        } else {
          setError('Failed to load incident details');
        }
      } finally {
        setLoading(false);
      }
    };

    if (incidentId) {
      fetchIncident();
    }
  }, [incidentId]);

  if (loading) {
    return (
      <div className="flex items-center justify-center h-64">
        <div className="text-slate-500 font-medium flex items-center space-x-2">
          <svg className="animate-spin h-5 w-5 text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle className="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="4"></circle>
            <path className="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <span>Loading incident data...</span>
        </div>
      </div>
    );
  }

  if (error || !data) {
    return (
      <div className="bg-red-50 border border-red-200 p-4 rounded text-red-800 max-w-5xl">
        <h3 className="font-semibold">{error || 'No data available'}</h3>
      </div>
    );
  }

  const { incident, evidence, llm_report, policy_decision, recovery, audit_events } = data;

  const getSeverityBadge = (severity: string) => {
    switch (severity) {
      case 'HIGH': return <span className="badge-red ml-2">{severity}</span>;
      case 'MEDIUM': return <span className="badge-yellow ml-2">{severity}</span>;
      case 'LOW': return <span className="badge-neutral ml-2">{severity}</span>;
      default: return <span className="badge-neutral ml-2">{severity}</span>;
    }
  };

  const getDecisionBadge = (decision: string) => {
    switch (decision) {
      case 'AUTO_APPROVED': return <span className="badge-green">{decision}</span>;
      case 'HUMAN_APPROVAL': return <span className="badge-yellow">{decision}</span>;
      case 'BLOCKED': return <span className="badge-red">{decision}</span>;
      default: return <span className="badge-neutral">{decision || 'PENDING'}</span>;
    }
  };

  const srChange = ((evidence?.success_rate_evidence?.current_success_rate || 0) - (evidence?.success_rate_evidence?.baseline_success_rate || 0)) * 100;

  return (
    <div className="space-y-6 max-w-5xl pb-12">
      <div className="flex justify-between items-start">
        <div className="space-y-1">
          <div className="flex items-center">
            <h1 className="text-xl font-bold font-mono text-slate-900 tracking-tight">{incident.incident_id}</h1>
            {getSeverityBadge(incident.severity)}
          </div>
          <p className="text-sm text-slate-500 font-medium">
            Detected: {new Date(incident.detection_timestamp).toLocaleString()}
          </p>
        </div>
        <Link to="/merchant" className="btn-secondary flex items-center">
          <svg className="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
          Dashboard
        </Link>
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
        {/* Left Column: Evidence & Details */}
        <div className="lg:col-span-2 space-y-6">
          <div className="card overflow-hidden">
            <div className="bg-slate-100 border-b border-slate-200 px-4 py-3 flex items-center space-x-2">
              <svg className="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
              <h2 className="font-bold text-sm text-slate-700 uppercase tracking-wider">Deterministic Evidence</h2>
            </div>
            
            <div className="p-4 grid grid-cols-2 md:grid-cols-4 gap-4 bg-white">
              <div>
                <p className="text-xs text-slate-500 font-semibold uppercase tracking-wider mb-1">Baseline SR</p>
                <p className="text-lg font-bold text-slate-900">{((evidence?.success_rate_evidence?.baseline_success_rate * 100).toFixed(1)}%</p>
              </div>
              <div>
                <p className="text-xs text-slate-500 font-semibold uppercase tracking-wider mb-1">Current SR</p>
                <p className="text-lg font-bold text-slate-900">{((evidence?.success_rate_evidence?.current_success_rate * 100).toFixed(1)}%</p>
              </div>
              <div>
                <p className="text-xs text-slate-500 font-semibold uppercase tracking-wider mb-1">Delta</p>
                <p className={`text-lg font-bold ${srChange < 0 ? 'text-red-600' : 'text-emerald-600'}`}>
                  {srChange > 0 ? '+' : ''}{srChange.toFixed(1)}%
                </p>
              </div>
              <div>
                <p className="text-xs text-slate-500 font-semibold uppercase tracking-wider mb-1">Revenue at Risk</p>
                <p className="text-lg font-bold text-slate-900 font-mono">₹{(incident.impact_evidence?.revenue_at_risk?.paise / 100).toLocaleString()}</p>
              </div>
            </div>

            <div className="border-t border-slate-100 p-4">
              <h3 className="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-3">Affected Segment</h3>
              <div className="flex flex-wrap gap-2 text-sm font-medium text-slate-700">
                <span className="bg-slate-100 px-2 py-1 rounded border border-slate-200">Method: {incident.affected_segment.payment_method}</span>
                <span className="bg-slate-100 px-2 py-1 rounded border border-slate-200">Bank: {incident.affected_segment.bank}</span>
                <span className="bg-slate-100 px-2 py-1 rounded border border-slate-200">Device: {incident.affected_segment.device}</span>
                <span className="bg-slate-100 px-2 py-1 rounded border border-slate-200">App: {incident.affected_segment.upi_app || 'ANY'}</span>
              </div>
            </div>
            
            {(evidence?.error_evidence && (
              <div className="border-t border-slate-100 p-4 grid grid-cols-2 gap-4">
                <div>
                  <p className="text-xs text-slate-500 font-semibold uppercase tracking-wider mb-1">Technical Error Rate</p>
                  <p className="font-bold text-slate-800 text-sm">{(evidence.error_evidence.current.technical_error_rate * 100).toFixed(1)}% (was {((evidence.error_evidence.baseline.technical_error_rate * 100).toFixed(1)}%)</p>
                </div>
                <div>
                  <p className="text-xs text-slate-500 font-semibold uppercase tracking-wider mb-1">Customer Error Rate</p>
                  <p className="font-bold text-slate-800 text-sm">{((evidence.error_evidence.current.customer_error_rate * 100).toFixed(1)}% (was {((evidence.error_evidence.baseline.customer_error_rate * 100).toFixed(1)}%)</p>
                </div>
              </div>
            )}
          </div>

          <div className="card overflow-hidden border-blue-200">
            <div className="bg-blue-50 border-b border-blue-200 px-4 py-3 flex items-center justify-between">
              <div className="flex items-center space-x-2">
                <svg className="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                <h2 className="font-bold text-sm text-blue-900 uppercase tracking-wider">AI Forensic Explanation</h2>
              </div>
              <span className="text-xs font-semibold text-blue-600 uppercase">LLM-Generated Explanation</span>
            </div>
            <div className="p-4 space-y-4 text-sm text-slate-700 leading-relaxed">
              {llm_report?.likely_cause ? (
                <>
                  <div>
                    <span className="font-semibold text-slate-900">Likely Cause:</span> {llm_report.likely_cause.primary}
                    <span className="ml-2 inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800">
                      Confidence: {(llm_report.likely_cause.confidence * 100).toFixed(0)}%
                    </span>
                  </div>
                  <div>
                    <span className="font-semibold text-slate-900">Explanation:</span> {llm_report.incident_summary?.what_happened || "No detailed explanation available."}
                  </div>
                  
                  {llm_report.recommended_actions && llm_report.recommended_actions.length > 0 && (
                    <div className="mt-4 border-t border-slate-100 pt-3">
                      <span className="font-semibold text-slate-900 block mb-2">Recommended Actions:</span>
                      <ul className="list-disc list-inside space-y-1">
                        {llm_report.recommended_actions.map((act: string, idx: number) => (
                          <li key={idx} className="text-slate-600">{act}</li>
                        ))}
                      </ul>
                    </div>
                  )}
                </>
              ) : (
                <p className="text-slate-500 italic">No AI explanation available yet.</p>
              )}
            </div>
          </div>
        </div>

        {/* Right Column: Policy, Recovery, Audit */}
        <div className="space-y-6">
          <div className="card overflow-hidden border-slate-300 shadow-sm">
            <div className="bg-slate-800 px-4 py-3 flex items-center justify-between">
              <h2 className="font-bold text-sm text-white uppercase tracking-wider flex items-center">
                <svg className="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                Policy Decision
              </h2>
            </div>
            <div className="p-4 bg-white">
              <div className="mb-4">
                {getDecisionBadge(policy_decision?.decision)}
              </div>
              
              {policy_decision?.decision ? (
                <div className="space-y-3">
                  <p className="text-sm text-slate-700 leading-snug">{policy_decision.human_readable_reason}</p>
                  {policy_decision.reason_codes?.length > 0 && (
                    <div className="flex flex-wrap gap-1.5 mt-2">
                      {policy_decision.reason_codes.map((code: string, i: number) => (
                        <span key={i} className="text-[10px] font-mono bg-slate-100 text-slate-600 px-1.5 py-0.5 rounded border border-slate-200">{code}</span>
                      ))}
                    </div>
                  )}
                </div>
              ) : (
                <p className="text-sm text-slate-500 italic">Policy engine has not processed this incident.</p>
              )}
            </div>
          </div>

          <div className="card overflow-hidden">
            <div className="bg-slate-100 border-b border-slate-200 px-4 py-3">
              <h2 className="font-bold text-sm text-slate-700 uppercase tracking-wider">Recovery Execution</h2>
            </div>
            <div className="p-4">
              {recovery?.recovery_id ? (
                <div className="space-y-3 text-sm">
                  <div className="flex justify-between items-center border-b border-slate-100 pb-2">
                    <span className="font-semibold text-slate-600">Action</span>
                    <span className="font-mono text-slate-800">{recovery.action_type}</span>
                  </div>
                  <div className="flex justify-between items-center border-b border-slate-100 pb-2">
                    <span className="font-semibold text-slate-600">Amount</span>
                    <span className="font-bold text-slate-900">₹{(recovery.amount_paise / 100).toLocaleString()}</span>
                  </div>
                  <div className="flex justify-between items-center pb-1">
                    <span className="font-semibold text-slate-600">Status</span>
                    <span className={`text-xs font-bold px-2 py-0.5 rounded border ${
                      recovery.state === 'COMPLETED' ? 'bg-emerald-50 text-emerald-700 border-emerald-200' :
                      recovery.state === 'PROCESSING' ? 'bg-blue-50 text-blue-700 border-blue-200' :
                      recovery.state === 'FAILED' ? 'bg-red-50 text-red-700 border-red-200' :
                      'bg-slate-100 text-slate-700 border-slate-200'
                    }`}>{recovery.state || 'NOT_EXECUTED'}</span>
                  </div>
                  {recovery.error && (
                    <div className="mt-2 p-2 bg-red-50 text-red-700 text-xs rounded border border-red-200">
                      {recovery.error}
                    </div>
                  )}
                </div>
              ) : (
                <p className="text-sm text-slate-500 italic">No recovery action taken or requested.</p>
              )}
            </div>
          </div>

          <div className="card overflow-hidden">
            <div className="bg-slate-100 border-b border-slate-200 px-4 py-3">
              <h2 className="font-bold text-sm text-slate-700 uppercase tracking-wider">Audit Trail</h2>
            </div>
            <div className="p-0">
              {audit_events?.length > 0 ? (
                <ul className="divide-y divide-slate-100 max-h-64 overflow-y-auto">
                  {audit_events.map((event: any, idx: number) => (
                    <li key={idx} className="p-3 text-xs flex flex-col">
                      <span className="font-medium text-slate-800">{event.event_type}</span>
                      <span className="text-slate-500 mt-0.5">{new Date(event.timestamp).toLocaleString()}</span>
                    </li>
                  ))}
                </ul>
              ) : (
                <p className="text-sm text-slate-500 italic p-4">No audit events found.</p>
              )}
            </div>
          </div>
        </div>
      </div>
    </div>
  );
};

export default MerchantIncidentDetail;
